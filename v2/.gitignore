# ========== 密钥红线：任何形式的本地环境变量都不进仓库 ==========
.env
.env.*
!.env.example

# ========== Python ==========
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ========== Node ==========
node_modules/
dist/
.vite/
npm-debug.log*
yarn-error.log*

# ========== 运行日志与调试产物 ==========
*.log
v2_logs/
# 调试用的原始响应转储（保留在本地排查，不进仓库）
docs/resp*.json
docs/sse_*.txt

# ========== 运行期数据（M5 SQLite）==========
# 行程库、对话记忆库都是运行时数据，不进仓库
data/
*.db
*.db-wal
*.db-shm

# ========== IDE / 系统 ==========
.idea/
.vscode/
.DS_Store
Thumbs.db
