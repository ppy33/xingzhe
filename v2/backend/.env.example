# ===== 高德开放平台 =====
# Web服务 Key（后端用：POI搜索/天气/路径规划/周边搜索）
AMAP_SERVER_KEY=你的Web服务Key

# Web端 JS API Key（前端用：地图展示/标注/路线绘制）
AMAP_JSAPI_KEY=你的JSAPI_Key
# JS API 安全密钥（创建 Key 时页面显示的 jscode）
AMAP_JSAPI_SECRET=你的jscode

# ===== DeepSeek =====
DEEPSEEK_API_KEY=你的DeepSeek_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MODEL_FAST=deepseek-flash
