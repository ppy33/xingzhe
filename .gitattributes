# 统一换行符：源码一律 LF，避免 Windows/Mac 协作者产生满屏无意义 diff
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# 锁文件视为自动生成，review 时折叠
package-lock.json linguist-generated=true
